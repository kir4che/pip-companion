{
  "name": "pip-companion",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser-extension-smoke.mjs",
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "render:social-preview": "node scripts/render-social-preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
