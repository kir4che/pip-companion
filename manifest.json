{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "0.6.0",
  "version_name": "0.6.0",
  "minimum_chrome_version": "116",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon.png"
    }
  },
  "options_ui": {
    "page": "ui/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*",
    "https://api.gamer.com.tw/*",
    "wss://irc-ws.chat.twitch.tv/*",
    "https://aisubtitle.hdslb.com/*"
  ],
  "optional_host_permissions": [
    "https://api.cognitive.microsofttranslator.com/*",
    "https://translation.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://bilibili.com/*",
        "*://*.bilibili.com/*",
        "*://twitch.tv/*",
        "*://*.twitch.tv/*",
        "*://ani.gamer.com.tw/*",
        "*://netflix.com/*",
        "*://*.netflix.com/*"
      ],
      "js": [],
      "css": ["content/floating-comments/index.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "all_frames": true,
      "world": "MAIN",
      "js": ["content/bridges/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://bilibili.com/*", "*://*.bilibili.com/*"],
      "world": "MAIN",
      "js": ["content/bridges/bilibili.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://ani.gamer.com.tw/*"],
      "all_frames": true,
      "world": "MAIN",
      "js": ["content/bridges/bahamut.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://netflix.com/*", "*://*.netflix.com/*"],
      "world": "MAIN",
      "js": ["content/bridges/netflix.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/playlist-icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
