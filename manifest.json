{
  "manifest_version": 3,
  "name": "幕伴 PiP · PiP Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "支援字幕、彈幕與留言的子母畫面播放器",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "幕伴 PiP · PiP Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.bilibili.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "shared/lib.js",
        "content/pip-audio.js",
        "content/pip-ui.js",
        "content/floating-comments.js",
        "content/danmaku.js",
        "content/content.js"
      ],
      "css": ["content/floating-comments.css"],
      "run_at": "document_idle"
    }
  ]
}
