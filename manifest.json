{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon.png"
    }
  },
  "options_ui": {
    "page": "ui/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*",
    "https://api.gamer.com.tw/*",
    "wss://irc-ws.chat.twitch.tv/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://translation.googleapis.com/*",
    "*://*.hdslb.com/*",
    "*://ani.gamer.com.tw/*",
    "*://*.gamer.com.tw/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "shared/locales.js",
        "shared/utils.js",
        "shared/site-utils.js",
        "shared/danmaku-settings.js",
        "shared/subtitle-settings.js",
        "shared/subtitle-translation-settings.js",
        "shared/custom-select.js",
        "shared/bilibili-danmaku-config.js",
        "content/pip/storyboard.js",
        "content/pip/audio.js",
        "content/pip/ui.js",
        "content/floating-comments/index.js",
        "content/danmaku/renderer.js",
        "content/danmaku/sources.js",
        "content/danmaku/bilibili.js",
        "content/danmaku/extra-danmaku.js",
        "content/danmaku/youtube.js",
        "content/danmaku/sender/bahamut.js",
        "content/danmaku/sender/bilibili.js",
        "content/danmaku/sender/youtube.js",
        "content/danmaku/sender/index.js",
        "content/danmaku/index.js",
        "content/platform.js",
        "content/video-source.js",
        "content/subtitles/providers/standard-text-track.js",
        "content/subtitles/bilibili.js",
        "content/subtitles/native-secondary-track.js",
        "content/subtitles/translation.js",
        "content/subtitles.js",
        "content/feedback.js",
        "content/pip/playlist.js",
        "content/pip/playback.js",
        "content/screenshot.js",
        "content/pip/lifecycle.js",
        "content/index.js"
      ],
      "css": ["content/floating-comments/index.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "all_frames": true,
      "world": "MAIN",
      "js": ["content/bridges/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://bilibili.com/*", "*://*.bilibili.com/*"],
      "world": "MAIN",
      "js": ["content/bridges/bilibili.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://ani.gamer.com.tw/*", "*://*.gamer.com.tw/*"],
      "all_frames": true,
      "world": "MAIN",
      "js": ["content/bridges/bahamut.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://netflix.com/*", "*://*.netflix.com/*"],
      "world": "MAIN",
      "js": ["content/bridges/netflix.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/playlist-icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
