{
  "manifest_version": 3,
  "name": "幕伴 PiP · PiP Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "讓網頁影片在子母畫面中播放，支援字幕、彈幕、截圖與浮動留言區。",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "幕伴 PiP · PiP Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon.png"
    }
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://ani.gamer.com.tw/*",
    "*://*.gamer.com.tw/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "shared/utils.js",
        "shared/site-utils.js",
        "shared/danmaku-settings.js",
        "shared/bilibili-danmaku-config.js",
        "content/pip/storyboard.js",
        "content/pip/audio.js",
        "content/pip/ui.js",
        "content/floating-comments/index.js",
        "content/danmaku/renderer.js",
        "content/danmaku/sources.js",
        "content/danmaku/bilibili.js",
        "content/danmaku/youtube.js",
        "content/danmaku/index.js",
        "content/video-source.js",
        "content/captions.js",
        "content/feedback.js",
        "content/pip/playback.js",
        "content/screenshot.js",
        "content/pip/lifecycle.js",
        "content/index.js"
      ],
      "css": ["content/floating-comments/index.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "all_frames": true,
      "world": "MAIN",
      "js": ["content/bridges/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://ani.gamer.com.tw/*", "*://*.gamer.com.tw/*"],
      "all_frames": true,
      "world": "MAIN",
      "js": ["content/bridges/bahamut.js"],
      "run_at": "document_start"
    }
  ]
}
